# ========================================================
# NEPAL DISTRIBUTORS - MONOREPO ENVIRONMENT VARIABLES
# ========================================================

# --- TRANSACTIONAL EMAIL CONFIGURATION (Cloudflare Workers & HTTP) ---
# Resend API Key (Recommended for Cloudflare Workers)
# Sign up at https://resend.com and grab an API key.
RESEND_API_KEY="re_123456789_abcdefg"

# SendGrid API Key (Alternative HTTP fallback)
# SENDGRID_API_KEY="SG.xxxxxxxxxxxx"

# Corporate Receiver Email for incoming B2B dealer inquiries
COMPANY_RECEIVER_EMAIL="distributor-inquiries@example.com"

# Verified sender email address / domain
EMAIL_FROM="Nepal Distributors <inquiries@resend.dev>"

# --- FRONTEND CLIENT CONFIGURATION (/client) ---
# Optional: Set this if your frontend is deployed separately (e.g. Cloudflare Pages)
# and needs to reach a remote Cloudflare Worker API URL.
# Leave blank or omit when using same-domain reverse proxy routing.
# VITE_API_BASE_URL="https://nepal-distributors-api.your-subdomain.workers.dev"

# --- CLOUDFLARE D1 DATABASE CONFIGURATION ---
# Configured in wrangler.toml via:
# [[d1_databases]]
# binding = "DB"
# database_name = "nepal-distributors-db"
# database_id = "<YOUR_D1_DATABASE_ID>"

# --- AI STUDIO CONTAINER RUNTIME ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
